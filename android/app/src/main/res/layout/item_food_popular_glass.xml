<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPopularRoot"
    android:layout_width="160dp"
    android:layout_height="235dp"
    android:layout_marginEnd="14dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#211F29"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_card"
        android:padding="10dp">

        <!-- Top Badges & Favorite Heart -->
        <TextView
            android:id="@+id/txtPopularTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_badge_spicy"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="Spicy"
            android:textColor="#FF5252"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnPopularFav"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:padding="4dp"
            android:src="@drawable/ic_glass_heart_outline" />

        <!-- Food Image -->
        <ImageView
            android:id="@+id/imgPopularFood"
            android:layout_width="120dp"
            android:layout_height="105dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/txtPopularTag"
            android:layout_marginTop="2dp"
            android:scaleType="fitCenter" />

        <!-- Dish Title -->
        <TextView
            android:id="@+id/txtPopularName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgPopularFood"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Spicy Chicken Burger"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Price and Circular (+) Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPopularPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹ 249"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnPopularAdd"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_circle_orange"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
