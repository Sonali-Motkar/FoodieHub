<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions for REST API Communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodieHub"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FoodieHub.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.FoodieHub.NoActionBar" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.FoodieHub.NoActionBar" />

        <!-- Main Discovery & Food Catalog -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Food Details Screen -->
        <activity
            android:name=".activities.FoodDetailActivity"
            android:exported="false" />

        <!-- Shopping Cart Activity -->
        <activity
            android:name=".activities.CartActivity"
            android:exported="false" />

        <!-- Order Success Screen -->
        <activity
            android:name=".activities.OrderSuccessActivity"
            android:exported="false"
            android:theme="@style/Theme.FoodieHub.NoActionBar" />

        <!-- Customer Order History -->
        <activity
            android:name=".activities.OrderHistoryActivity"
            android:exported="false" />

        <!-- Admin Control Panel -->
        <activity
            android:name=".activities.AdminActivity"
            android:exported="false" />

    </application>

</manifest>
